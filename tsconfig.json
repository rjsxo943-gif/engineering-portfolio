{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "lib": [
      "ES2022",
      "DOM",
      "ESNext.Disposable"
    ],
    "noEmit": true
  },
  "include": [
    "src",
    "vite.config.ts"
  ]
}
